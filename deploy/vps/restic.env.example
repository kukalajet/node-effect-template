# Template for /etc/node-effect-template/restic.env (mode 0600, owned by root),
# read by the backup service. Any S3-compatible bucket works (Cloudflare R2,
# Backblaze B2, Wasabi, AWS S3); keep it with a different provider than the
# server.
RESTIC_REPOSITORY=s3:https://<s3-endpoint>/<bucket>
# Backups cannot be restored without this password; keep it in the password
# manager.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 expects `auto`; other providers expect their bucket's region.
AWS_DEFAULT_REGION=auto
# Optional dead man's switch URL, pinged after each successful backup.
HEARTBEAT_URL=
