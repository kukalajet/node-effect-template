POSTGRES_DB=node_effect
POSTGRES_USER=node_effect
POSTGRES_PASSWORD=node_effect
POSTGRES_PORT=5432
# Used by native commands; Compose supplies its own internal DATABASE_URL.
DATABASE_URL=postgresql://node_effect:node_effect@127.0.0.1:5432/node_effect
API_HOST=127.0.0.1
API_PORT=8000
WORKER_POLL_INTERVAL_MS=5000
